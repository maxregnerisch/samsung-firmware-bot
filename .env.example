# Samsung Custom Firmware Bot Environment Configuration

# Telegram API Credentials (Required)
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Bot Token (Required)
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Storage Configuration
LOCAL_STORAGE=/app/storage
WEB_STORAGE=http://localhost:8080

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/bot.log

# Optional: Database Configuration (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/samsung_firmware_bot
# REDIS_URL=redis://localhost:6379/0

# Optional: File Upload Limits
MAX_UPLOAD_SIZE=5368709120  # 5GB in bytes
MAX_CONCURRENT_BUILDS=3

# Optional: Samsung API Configuration (if available)
# SAMSUNG_API_KEY=your_samsung_api_key
# SAMSUNG_API_SECRET=your_samsung_api_secret

# Optional: Security Configuration
# ALLOWED_USERS=user_id1,user_id2,user_id3  # Comma-separated user IDs
# ADMIN_USERS=admin_user_id1,admin_user_id2

# Optional: Performance Configuration
WORKER_THREADS=4
DOWNLOAD_TIMEOUT=3600  # 1 hour in seconds
BUILD_TIMEOUT=1800     # 30 minutes in seconds

